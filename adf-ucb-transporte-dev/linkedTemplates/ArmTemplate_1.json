		{
			"name": "[concat(parameters('factoryName'), '/df_bronze_paradas')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "Bronze"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "bronze_paradas_csv",
								"type": "DatasetReference"
							},
							"name": "csv"
						},
						{
							"dataset": {
								"referenceName": "bronze_paradas_sql",
								"type": "DatasetReference"
							},
							"name": "sql"
						},
						{
							"dataset": {
								"referenceName": "bronze_paradas_xls",
								"type": "DatasetReference"
							},
							"name": "xls"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "dw_bronze_paradas_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "select1"
						},
						{
							"name": "select2"
						},
						{
							"name": "union1"
						},
						{
							"name": "union2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          nro_parada as string,",
						"          nombre_parada as string,",
						"          zona as string,",
						"          latitud as string,",
						"          longitud as string,",
						"          fecha_desde as string,",
						"          fecha_hasta as string,",
						"          estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> csv",
						"source(output(",
						"          AnioFuente as string,",
						"          ParadaHistoricaId as string,",
						"          CodigoPublicado as string,",
						"          NombreParada as string,",
						"          Zona as string,",
						"          Latitud as string,",
						"          Longitud as string,",
						"          VigenciaDesde as string,",
						"          VigenciaHasta as string,",
						"          Estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> sql",
						"source(output(",
						"          nro_parada as string,",
						"          nombre_parada as string,",
						"          zona as string,",
						"          latitud as string,",
						"          longitud as string,",
						"          fecha_desde as string,",
						"          fecha_hasta as string,",
						"          estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> xls",
						"csv select(mapColumn(",
						"          ParadaHistoricaId = nro_parada,",
						"          NombreParada = nombre_parada,",
						"          Zona = zona,",
						"          Latitud = latitud,",
						"          Longitud = longitud,",
						"          VigenciaDesde = fecha_desde,",
						"          VigenciaHasta = fecha_hasta,",
						"          Estado = estado",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"xls select(mapColumn(",
						"          ParadaHistoricaId = nro_parada,",
						"          NombreParada = nombre_parada,",
						"          Zona = zona,",
						"          Latitud = latitud,",
						"          Longitud = longitud,",
						"          VigenciaDesde = fecha_desde,",
						"          VigenciaHasta = fecha_hasta,",
						"          Estado = estado",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select2",
						"select1, sql union(byName: true)~> union1",
						"union1, select2 union(byName: true)~> union2",
						"union2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          AnioFuente as string,",
						"          ParadaHistoricaId as string,",
						"          CodigoPublicado as string,",
						"          NombreParada as string,",
						"          Zona as string,",
						"          Latitud as string,",
						"          Longitud as string,",
						"          VigenciaDesde as string,",
						"          VigenciaHasta as string,",
						"          Estado as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          AnioFuente,",
						"          ParadaHistoricaId,",
						"          CodigoPublicado,",
						"          NombreParada,",
						"          Zona,",
						"          Latitud,",
						"          Longitud,",
						"          VigenciaDesde,",
						"          VigenciaHasta,",
						"          Estado",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/dw_bronze_paradas_sql')]"
			]
		},
